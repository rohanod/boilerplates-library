{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "labels": [
    "renovate"
  ],
  "packageRules": [
    {
      "description": "Group boilerplate image updates",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "boilerplates/**"
      ],
      "additionalBranchPrefix": "boilerplates-"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Docker images in boilerplates",
      "fileMatch": [
        "^boilerplates/[^/]+/files/compose\\.ya?ml$"
      ],
      "matchStrings": [
        "image:\\s*(?<depName>[^:\\s]+):(?<currentValue>[^\\s\\n<]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
