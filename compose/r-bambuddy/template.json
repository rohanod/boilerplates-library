{
  "slug": "r-bambuddy",
  "kind": "compose",
  "metadata": {
    "name": "r-bambuddy",
    "description": "BamBuddy print-farm management for Bambu Lab printers, with printer discovery, scheduling, archives, and optional integrations.",
    "tags": [
      "3d-printing",
      "bambu-lab",
      "printer-management",
      "volumes"
    ],
    "icon": {
      "provider": "selfhst",
      "id": "bambuddy"
    },
    "draft": false,
    "version": {
      "name": "0.2.4.9",
      "source_dep_name": "ghcr.io/maziggy/bambuddy",
      "source_dep_version": "0.2.4.9"
    }
  },
  "variables": [
    {
      "title": "General",
      "name": "general",
      "items": [
        {
          "name": "service_name",
          "type": "str",
          "title": "Service Name",
          "required": false,
          "default": "bambuddy",
          "config": {
            "placeholder": "bambuddy"
          }
        },
        {
          "name": "container_name",
          "type": "str",
          "title": "Container Name",
          "required": false,
          "default": "bambuddy",
          "description": "Leave empty to let Docker Compose generate the container name.",
          "config": {
            "placeholder": "bambuddy"
          }
        },
        {
          "name": "container_timezone",
          "type": "str",
          "title": "Container Timezone",
          "required": true,
          "default": "Europe/Berlin",
          "config": {
            "placeholder": "Europe/Berlin"
          }
        },
        {
          "name": "puid",
          "type": "int",
          "title": "User ID",
          "required": true,
          "default": 1000,
          "description": "UID used for files written to persistent storage."
        },
        {
          "name": "pgid",
          "type": "int",
          "title": "Group ID",
          "required": true,
          "default": 1000,
          "description": "GID used for files written to persistent storage."
        },
        {
          "name": "restart_policy",
          "type": "enum",
          "title": "Restart Policy",
          "required": true,
          "default": "unless-stopped",
          "config": {
            "options": [
              "unless-stopped",
              "always",
              "on-failure",
              "no"
            ]
          }
        },
        {
          "name": "stop_grace_period",
          "type": "str",
          "title": "Stop Grace Period",
          "required": true,
          "default": "30s",
          "config": {
            "placeholder": "30s"
          }
        },
        {
          "name": "debug_enabled",
          "type": "bool",
          "title": "Debug Logging",
          "required": false,
          "default": false
        },
        {
          "name": "log_level",
          "type": "enum",
          "title": "Log Level",
          "required": true,
          "default": "INFO",
          "config": {
            "options": [
              "DEBUG",
              "INFO",
              "WARNING",
              "ERROR"
            ]
          }
        }
      ]
    },
    {
      "title": "Networking",
      "name": "networking",
      "items": [
        {
          "name": "network_mode",
          "type": "enum",
          "title": "Network Mode",
          "required": true,
          "default": "host",
          "description": "Host mode enables automatic LAN printer discovery on Linux. Bridge mode is required on Docker Desktop and usually requires adding printers manually by IP.",
          "config": {
            "options": [
              "host",
              "bridge"
            ]
          }
        },
        {
          "name": "application_port",
          "type": "int",
          "title": "Application Port",
          "required": true,
          "default": 8000,
          "description": "Port BamBuddy listens on. In host mode this is the host port.",
          "config": {
            "placeholder": "8000"
          }
        },
        {
          "name": "ports_web",
          "type": "str",
          "title": "Web UI Host Port",
          "required": true,
          "default": "8000",
          "needs": [
            "network_mode=bridge"
          ],
          "config": {
            "placeholder": "8000"
          }
        },
        {
          "name": "virtual_printer_enabled",
          "type": "bool",
          "title": "Virtual Printer Ports",
          "required": false,
          "default": false,
          "needs": [
            "network_mode=bridge"
          ],
          "description": "Publish the official virtual-printer port set for up to three virtual printers."
        },
        {
          "name": "virtual_printer_pasv_address",
          "type": "str",
          "title": "FTP Passive Address",
          "required": true,
          "default": "192.168.1.100",
          "needs": [
            "network_mode=bridge",
            "virtual_printer_enabled=true"
          ],
          "description": "LAN IP of the Docker host advertised to FTP clients.",
          "config": {
            "placeholder": "192.168.1.100"
          }
        }
      ]
    },
    {
      "title": "Home Assistant",
      "name": "home_assistant",
      "toggle": "home_assistant_enabled",
      "items": [
        {
          "name": "home_assistant_enabled",
          "type": "bool",
          "title": "Home Assistant",
          "required": false,
          "default": false
        },
        {
          "name": "home_assistant_url",
          "type": "str",
          "title": "Home Assistant URL",
          "required": true,
          "default": "http://homeassistant.local:8123",
          "needs": [
            "home_assistant_enabled=true"
          ],
          "config": {
            "placeholder": "http://homeassistant.local:8123"
          }
        },
        {
          "name": "home_assistant_token",
          "type": "secret",
          "title": "Long-Lived Access Token",
          "required": true,
          "needs": [
            "home_assistant_enabled=true"
          ]
        },
        {
          "name": "trusted_frame_origins",
          "type": "str",
          "title": "Trusted Frame Origins",
          "required": false,
          "description": "Comma-separated exact origins allowed to embed BamBuddy, such as a Home Assistant URL.",
          "config": {
            "placeholder": "https://homeassistant.example.com"
          }
        }
      ]
    },
    {
      "title": "Optional Services",
      "name": "optional_services",
      "items": [
        {
          "name": "external_database_enabled",
          "type": "bool",
          "title": "External PostgreSQL",
          "required": false,
          "default": false,
          "description": "Use an existing PostgreSQL server instead of the default SQLite database."
        },
        {
          "name": "database_url",
          "type": "secret",
          "title": "PostgreSQL Connection URL",
          "required": true,
          "needs": [
            "external_database_enabled=true"
          ],
          "description": "SQLAlchemy URL, for example postgresql+asyncpg://user:password@host:5432/bambuddy."
        },
        {
          "name": "slicer_api_url",
          "type": "str",
          "title": "Slicer API URL",
          "required": false,
          "description": "Optional URL of a separately deployed OrcaSlicer API service.",
          "config": {
            "placeholder": "http://192.168.1.100:3003"
          }
        }
      ]
    },
    {
      "title": "External Library",
      "name": "external_library",
      "toggle": "external_library_enabled",
      "items": [
        {
          "name": "external_library_enabled",
          "type": "bool",
          "title": "External File Library",
          "required": false,
          "default": false
        },
        {
          "name": "external_library_host_path",
          "type": "str",
          "title": "Host Library Path",
          "required": true,
          "default": "/mnt/nas/3d-prints",
          "needs": [
            "external_library_enabled=true"
          ],
          "config": {
            "placeholder": "/mnt/nas/3d-prints"
          }
        },
        {
          "name": "external_library_container_path",
          "type": "str",
          "title": "Container Library Path",
          "required": true,
          "default": "/external/library",
          "needs": [
            "external_library_enabled=true"
          ],
          "description": "Absolute in-container path added to BAMBUDDY_EXTERNAL_ROOTS.",
          "config": {
            "placeholder": "/external/library"
          }
        }
      ]
    },
    {
      "title": "Volumes",
      "name": "volume",
      "items": [
        {
          "name": "volume_mode",
          "type": "enum",
          "title": "Volume Mode",
          "required": true,
          "default": "local",
          "description": "Storage mode for the database, archives, thumbnails, and logs.",
          "config": {
            "options": [
              "local",
              "mount",
              "nfs"
            ]
          }
        },
        {
          "name": "volume_mount_path",
          "type": "str",
          "title": "Mount Path",
          "required": true,
          "default": "/data/bambuddy",
          "needs": [
            "volume_mode=mount"
          ],
          "config": {
            "placeholder": "/data/bambuddy"
          }
        },
        {
          "name": "volume_nfs_server",
          "type": "str",
          "title": "NFS Server",
          "required": true,
          "default": "NFS_SERVER",
          "needs": [
            "volume_mode=nfs"
          ],
          "config": {
            "placeholder": "NFS_SERVER"
          }
        },
        {
          "name": "volume_nfs_path",
          "type": "str",
          "title": "NFS Path",
          "required": true,
          "default": "/export/bambuddy",
          "needs": [
            "volume_mode=nfs"
          ],
          "config": {
            "placeholder": "/export/bambuddy"
          }
        },
        {
          "name": "volume_nfs_options",
          "type": "str",
          "title": "NFS Options",
          "required": true,
          "default": "rw,nolock,soft",
          "needs": [
            "volume_mode=nfs"
          ],
          "config": {
            "placeholder": "rw,nolock,soft"
          }
        }
      ]
    }
  ]
}
