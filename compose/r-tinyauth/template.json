{
  "slug": "r-tinyauth",
  "kind": "compose",
  "metadata": {
    "name": "r-tinyauth",
    "description": "Lightweight authentication gateway for protecting self-hosted applications with forward-auth and proxy integrations.",
    "tags": [
      "authentication",
      "forward-auth",
      "traefik",
      "volumes"
    ],
    "icon": {
      "provider": "selfhst",
      "id": "tinyauth"
    },
    "draft": false,
    "version": {
      "name": "v5.1.2",
      "source_dep_name": "ghcr.io/tinyauthapp/tinyauth",
      "source_dep_version": "v5.1.2"
    }
  },
  "variables": [
    {
      "title": "General",
      "name": "general",
      "items": [
        {
          "name": "service_name",
          "type": "str",
          "title": "Service Name",
          "required": false,
          "default": "tinyauth",
          "config": {
            "placeholder": "tinyauth"
          }
        },
        {
          "name": "restart_policy",
          "type": "enum",
          "title": "Restart Policy",
          "required": true,
          "default": "unless-stopped",
          "config": {
            "options": [
              "unless-stopped",
              "always",
              "on-failure",
              "no"
            ]
          }
        }
      ]
    },
    {
      "title": "Ports",
      "name": "ports",
      "items": [
        {
          "name": "ports_http",
          "type": "str",
          "title": "HTTP Port",
          "required": false,
          "default": "3000",
          "description": "Host port exposed when Traefik integration is disabled.",
          "config": {
            "placeholder": "3000"
          }
        }
      ]
    },
    {
      "title": "Application",
      "name": "application",
      "items": [
        {
          "name": "app_url",
          "type": "str",
          "title": "Application URL",
          "required": true,
          "default": "http://localhost:3000",
          "description": "Public URL used by TinyAuth for redirects and cookies. Use the Traefik URL when reverse-proxied.",
          "config": {
            "placeholder": "https://auth.home.arpa"
          }
        },
        {
          "name": "auth_users",
          "type": "secret",
          "title": "Users",
          "required": true,
          "description": "Comma-separated username:bcrypt-hash entries. Generate a bcrypt hash with TinyAuth's password utility or bcrypt tooling.",
          "config": {
            "placeholder": "admin:$2a$10$..."
          }
        },
        {
          "name": "trusted_proxies",
          "type": "str",
          "title": "Trusted Proxies",
          "required": true,
          "default": "172.17.0.0/16",
          "description": "Comma-separated proxy IPs or CIDRs allowed to provide forwarded client headers.",
          "config": {
            "placeholder": "172.17.0.0/16"
          }
        },
        {
          "name": "secure_cookie",
          "type": "bool",
          "title": "Secure Cookies",
          "required": false,
          "default": true,
          "description": "Set secure cookies; keep enabled when TinyAuth is served over HTTPS."
        }
      ]
    },
    {
      "title": "Traefik",
      "name": "traefik",
      "toggle": "traefik_enabled",
      "items": [
        {
          "name": "traefik_enabled",
          "type": "bool",
          "title": "Traefik",
          "required": false,
          "default": false,
          "description": "Attach to an external Traefik network and create routing labels for TinyAuth."
        },
        {
          "name": "traefik_host",
          "type": "str",
          "title": "Host",
          "required": true,
          "default": "auth",
          "needs": [
            "traefik_enabled=true"
          ],
          "config": {
            "placeholder": "auth"
          }
        },
        {
          "name": "traefik_domain",
          "type": "str",
          "title": "Domain",
          "required": true,
          "default": "home.arpa",
          "needs": [
            "traefik_enabled=true"
          ],
          "config": {
            "placeholder": "home.arpa"
          }
        },
        {
          "name": "traefik_entrypoint",
          "type": "str",
          "title": "Entrypoint",
          "required": true,
          "default": "web",
          "needs": [
            "traefik_enabled=true"
          ],
          "config": {
            "placeholder": "web"
          }
        },
        {
          "name": "traefik_network",
          "type": "str",
          "title": "Network",
          "required": true,
          "default": "traefik",
          "needs": [
            "traefik_enabled=true"
          ],
          "config": {
            "placeholder": "traefik"
          }
        },
        {
          "name": "traefik_tls_enabled",
          "type": "bool",
          "title": "TLS",
          "required": false,
          "default": false,
          "needs": [
            "traefik_enabled=true"
          ]
        },
        {
          "name": "traefik_tls_entrypoint",
          "type": "str",
          "title": "TLS Entrypoint",
          "required": true,
          "default": "websecure",
          "needs": [
            "traefik_enabled=true",
            "traefik_tls_enabled=true"
          ],
          "config": {
            "placeholder": "websecure"
          }
        },
        {
          "name": "traefik_tls_certresolver",
          "type": "str",
          "title": "Cert Resolver",
          "required": true,
          "default": "cloudflare",
          "needs": [
            "traefik_enabled=true",
            "traefik_tls_enabled=true"
          ],
          "config": {
            "placeholder": "cloudflare"
          }
        }
      ]
    },
    {
      "title": "Volumes",
      "name": "volume",
      "items": [
        {
          "name": "volume_mode",
          "type": "enum",
          "title": "Volume Mode",
          "required": true,
          "default": "local",
          "description": "Storage mode for TinyAuth's SQLite database.",
          "config": {
            "options": [
              "local",
              "mount",
              "nfs"
            ]
          }
        },
        {
          "name": "volume_mount_path",
          "type": "str",
          "title": "Mount Path",
          "required": true,
          "default": "/data/tinyauth",
          "needs": [
            "volume_mode=mount"
          ],
          "config": {
            "placeholder": "/data/tinyauth"
          }
        },
        {
          "name": "volume_nfs_server",
          "type": "str",
          "title": "NFS Server",
          "required": true,
          "default": "NFS_SERVER",
          "needs": [
            "volume_mode=nfs"
          ],
          "config": {
            "placeholder": "NFS_SERVER"
          }
        },
        {
          "name": "volume_nfs_path",
          "type": "str",
          "title": "NFS Path",
          "required": true,
          "default": "/export/tinyauth",
          "needs": [
            "volume_mode=nfs"
          ],
          "config": {
            "placeholder": "/export/tinyauth"
          }
        },
        {
          "name": "volume_nfs_options",
          "type": "str",
          "title": "NFS Options",
          "required": true,
          "default": "rw,nolock,soft",
          "needs": [
            "volume_mode=nfs"
          ],
          "config": {
            "placeholder": "rw,nolock,soft"
          }
        }
      ]
    }
  ]
}
