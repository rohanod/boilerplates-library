NEXTAUTH_URL='<< public_url >>'
NEXTAUTH_SECRET='__COPIER_NEXTAUTH_SECRET__'
MEILI_MASTER_KEY='__COPIER_MEILI_MASTER_KEY__'
LOG_LEVEL='<< log_level >>'
DISABLE_SIGNUPS='<< disable_signups | lower >>'
RATE_LIMITING_ENABLED='<< rate_limiting_enabled | lower >>'
CRAWLER_NUM_WORKERS='<< crawler_num_workers >>'
CRAWLER_DOWNLOAD_BANNER_IMAGE='<< crawler_download_banner_image | lower >>'
CRAWLER_STORE_SCREENSHOT='<< crawler_store_screenshot | lower >>'
CRAWLER_FULL_PAGE_SCREENSHOT='<< crawler_full_page_screenshot | lower >>'
CRAWLER_STORE_PDF='<< crawler_store_pdf | lower >>'
CRAWLER_FULL_PAGE_ARCHIVE='<< crawler_full_page_archive | lower >>'
<%- if crawler_http_proxy %>
CRAWLER_HTTP_PROXY='<< crawler_http_proxy >>'
<%- endif %>
<%- if crawler_https_proxy %>
CRAWLER_HTTPS_PROXY='<< crawler_https_proxy >>'
<%- endif %>
<%- if crawler_no_proxy %>
CRAWLER_NO_PROXY='<< crawler_no_proxy >>'
<%- endif %>
<%- if crawler_allowed_internal_hostnames %>
CRAWLER_ALLOWED_INTERNAL_HOSTNAMES='<< crawler_allowed_internal_hostnames >>'
<%- endif %>
DB_WAL_MODE='<< db_wal_mode | lower >>'

<%- if ai_provider == 'openai' %>
OPENAI_API_KEY='<< openai_api_key >>'
<%- if openai_base_url %>
OPENAI_BASE_URL='<< openai_base_url >>'
<%- endif %>
INFERENCE_TEXT_MODEL='<< inference_text_model >>'
INFERENCE_IMAGE_MODEL='<< inference_image_model >>'
INFERENCE_LANG='<< inference_language >>'
INFERENCE_ENABLE_AUTO_SUMMARIZATION='<< inference_auto_summarization | lower >>'
<%- elif ai_provider == 'ollama' %>
OLLAMA_BASE_URL='<< ollama_base_url >>'
<%- if ollama_keep_alive %>
OLLAMA_KEEP_ALIVE='<< ollama_keep_alive >>'
<%- endif %>
INFERENCE_TEXT_MODEL='<< inference_text_model >>'
INFERENCE_IMAGE_MODEL='<< inference_image_model >>'
INFERENCE_LANG='<< inference_language >>'
INFERENCE_ENABLE_AUTO_SUMMARIZATION='<< inference_auto_summarization | lower >>'
<%- endif %>

<%- if oidc_enabled %>
OAUTH_WELLKNOWN_URL='<< oidc_wellknown_url >>'
OAUTH_CLIENT_ID='<< oidc_client_id >>'
OAUTH_CLIENT_SECRET='<< oidc_client_secret >>'
OAUTH_SCOPE='<< oidc_scope >>'
OAUTH_PROVIDER_NAME='<< oidc_provider_name >>'
OAUTH_AUTO_REDIRECT='<< oidc_auto_redirect | lower >>'
OAUTH_TIMEOUT='<< oidc_timeout >>'
OAUTH_ALLOW_DANGEROUS_EMAIL_ACCOUNT_LINKING='false'
<%- endif %>

<%- if email_enabled %>
EMAIL_VERIFICATION_REQUIRED='<< email_verification_required | lower >>'
SMTP_HOST='<< smtp_host >>'
SMTP_PORT='<< smtp_port >>'
SMTP_SECURE='<< smtp_secure | lower >>'
SMTP_USER='<< smtp_user >>'
SMTP_PASSWORD='<< smtp_password >>'
SMTP_FROM='<< smtp_from >>'
<%- endif %>

<%- if s3_enabled %>
ASSET_STORE_S3_ENDPOINT='<< s3_endpoint >>'
ASSET_STORE_S3_REGION='<< s3_region >>'
ASSET_STORE_S3_BUCKET='<< s3_bucket >>'
ASSET_STORE_S3_ACCESS_KEY_ID='<< s3_access_key_id >>'
ASSET_STORE_S3_SECRET_ACCESS_KEY='<< s3_secret_access_key >>'
ASSET_STORE_S3_FORCE_PATH_STYLE='<< s3_force_path_style | lower >>'
<%- endif %>
