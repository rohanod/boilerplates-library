<%- if npm_database_type == 'sqlite' %>
DB_SQLITE_FILE='/data/database.sqlite'
<%- elif npm_database_type == 'mysql' %>
DB_MYSQL_HOST='<< npm_database_host >>'
DB_MYSQL_PORT='<< npm_database_port >>'
DB_MYSQL_USER='<< npm_database_user >>'
DB_MYSQL_PASSWORD='<< npm_database_password >>'
DB_MYSQL_NAME='<< npm_database_name >>'
DB_MYSQL_SSL='<< npm_mysql_ssl | lower >>'
DB_MYSQL_SSL_REJECT_UNAUTHORIZED='<< npm_mysql_ssl_reject_unauthorized | lower >>'
DB_MYSQL_SSL_VERIFY_IDENTITY='<< npm_mysql_ssl_verify_identity | lower >>'
<%- elif npm_database_type == 'postgres' %>
DB_POSTGRES_HOST='<< npm_database_host >>'
DB_POSTGRES_PORT='<< npm_database_port >>'
DB_POSTGRES_USER='<< npm_database_user >>'
DB_POSTGRES_PASSWORD='<< npm_database_password >>'
DB_POSTGRES_NAME='<< npm_database_name >>'
<%- endif %>
<%- if initial_admin_enabled %>
INITIAL_ADMIN_EMAIL='<< initial_admin_email >>'
INITIAL_ADMIN_PASSWORD='<< initial_admin_password >>'
<%- endif %>
