TINYAUTH_APPURL='<< app_url >>'
<%- if 'local' in auth_sources %>
TINYAUTH_AUTH_USERS='<< auth_users >>'
<%- endif %>
TINYAUTH_AUTH_SECURECOOKIE='<< secure_cookie | lower >>'
TINYAUTH_AUTH_SUBDOMAINSENABLED='<< subdomains_enabled | lower >>'
TINYAUTH_AUTH_SESSIONEXPIRY='<< session_expiry >>'
TINYAUTH_AUTH_SESSIONMAXLIFETIME='<< session_max_lifetime >>'
TINYAUTH_AUTH_LOGINTIMEOUT='<< login_timeout >>'
TINYAUTH_AUTH_LOGINMAXRETRIES='<< login_max_retries >>'
TINYAUTH_AUTH_ACLS_POLICY='<< acl_policy >>'
<%- if trusted_proxies %>
TINYAUTH_AUTH_TRUSTEDPROXIES='<< trusted_proxies >>'
<%- endif %>
<%- if ip_allow %>
TINYAUTH_AUTH_IP_ALLOW='<< ip_allow >>'
<%- endif %>
<%- if ip_block %>
TINYAUTH_AUTH_IP_BLOCK='<< ip_block >>'
<%- endif %>
<%- if ip_bypass %>
TINYAUTH_AUTH_IP_BYPASS='<< ip_bypass >>'
<%- endif %>

<%- if 'oauth' in auth_sources %>
TINYAUTH_OAUTH_PROVIDERS_<< oauth_provider_name | upper >>_CLIENTID='<< oauth_client_id >>'
TINYAUTH_OAUTH_PROVIDERS_<< oauth_provider_name | upper >>_CLIENTSECRET='<< oauth_client_secret >>'
TINYAUTH_OAUTH_PROVIDERS_<< oauth_provider_name | upper >>_AUTHURL='<< oauth_auth_url >>'
TINYAUTH_OAUTH_PROVIDERS_<< oauth_provider_name | upper >>_TOKENURL='<< oauth_token_url >>'
TINYAUTH_OAUTH_PROVIDERS_<< oauth_provider_name | upper >>_USERINFOURL='<< oauth_user_info_url >>'
TINYAUTH_OAUTH_PROVIDERS_<< oauth_provider_name | upper >>_SCOPES='<< oauth_scopes >>'
TINYAUTH_OAUTH_PROVIDERS_<< oauth_provider_name | upper >>_INSECURE='<< oauth_insecure | lower >>'
<%- if oauth_whitelist %>
TINYAUTH_OAUTH_PROVIDERS_<< oauth_provider_name | upper >>_WHITELIST='<< oauth_whitelist >>'
<%- endif %>
<%- if oauth_redirect_url %>
TINYAUTH_OAUTH_PROVIDERS_<< oauth_provider_name | upper >>_REDIRECTURL='<< oauth_redirect_url >>'
<%- endif %>
<%- endif %>

<%- if 'ldap' in auth_sources %>
TINYAUTH_LDAP_ADDRESS='<< ldap_address >>'
TINYAUTH_LDAP_BINDDN='<< ldap_bind_dn >>'
TINYAUTH_LDAP_BINDPASSWORD='<< ldap_bind_password >>'
TINYAUTH_LDAP_BASEDN='<< ldap_base_dn >>'
TINYAUTH_LDAP_SEARCHFILTER='<< ldap_search_filter >>'
TINYAUTH_LDAP_INSECURE='<< ldap_insecure | lower >>'
TINYAUTH_LDAP_GROUPCACHETTL='<< ldap_group_cache_ttl >>'
<%- endif %>

TINYAUTH_UI_TITLE='<< ui_title >>'
TINYAUTH_UI_FORGOTPASSWORDMESSAGE='<< ui_forgot_password_message >>'
TINYAUTH_ANALYTICS_ENABLED='<< analytics_enabled | lower >>'
TINYAUTH_LOG_LEVEL='<< log_level >>'
TINYAUTH_LOG_JSON='<< log_json | lower >>'
